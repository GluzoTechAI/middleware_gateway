# Environment and secrets
.env
.env.*
!.env.example

# Runtime data (never commit logs or workflow state)
storage/logs/*
!storage/logs/.gitkeep
storage/workflows/*
!storage/workflows/.gitkeep
tmp/
*.log

# Build and test artifacts
bin/
dist/
# `go build ./cmd/devstack` at the repo root writes devstack.exe beside the
# source rather than into bin/, and it is 32 MB. Ignored by extension so no
# blanket `git add` can commit it.
*.exe
coverage.out
*.test
*.out
*.prof

# IDE and OS state
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# IDE tooling output
git-history/
